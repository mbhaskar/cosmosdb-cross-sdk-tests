    "regions": [
      { "name": "East US", "gatewayPort": 49151, "regionId": 0 }
    ],
    "replication": { "minDelayMs": 0, "maxDelayMs": 0, "maxBufferedReplications": 10000 }
  },
  "management": { "port": 49150 },
  "databases": [
    {
      "id": "testdb",
      "containers": [
        {
          "id": "testcoll",
          "partitionKey": { "paths": ["/pk"], "kind": "Hash", "version": 2 },
          "partitionCount": 4,
          "throughput": 400,
          "seedItems": [
            { "partitionKey": ["pk1"], "document": { "id": "1", "pk": "pk1", "value": 42 } },
            { "partitionKey": ["pk2"], "document": { "id": "2", "pk": "pk2", "value": 7 } }
          ]
        }
      ]
    }
  ]
}
